node_modules/
dist/
*.log
.DS_Store
.venv/
__pycache__/
*.py[cod]

# Local dumps remain ignored. Tracked under .data: protocol journey scenes
# (nested state tree) and the scale generator. Each has its own gitignore
# for generated runs where needed.
.data/*
!.data/scenes/
!.data/scale/
.session_tmps/

# Archify visual-review sidecars are local QA evidence, not source artifacts.
docs/*.visual-check.*.png
docs/*.visual-check.html
docs/*.visual-check.json

# CLI workspace (FileGit repos + Catalog/Writer state)
.kc/
.kc-home/

# Go build artifacts
/kc
*.test

# Generated inventories and source-bound validation runs; never acceptance oracles.
/.validation/

# Dataset console build output (source in webui/). The directory must exist
# for go:embed; only the placeholder is tracked.
cli/webapp/*
!cli/webapp/.gitkeep
