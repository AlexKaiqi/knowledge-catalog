FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global @deepseek-ai/dsh@0.1.1-rc.2 pnpm@11.22.0
WORKDIR /opt/dsh-loom
COPY dsh-plugin/package.json dsh-plugin/package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts
COPY dsh-plugin/ ./
RUN npm run build \
    && DSH_HOME=/opt/dsh-home dsh plugin --profile web add file:/opt/dsh-loom \
    && DSH_HOME=/opt/dsh-home dsh plugin --profile headless add file:/opt/dsh-loom

COPY .scenes/data-warehouse/validation/runtime/dsh-stack/scripts/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint
RUN chmod 0755 /usr/local/bin/dsh-entrypoint

EXPOSE 7400
ENTRYPOINT ["/usr/local/bin/dsh-entrypoint"]
CMD ["serve"]
