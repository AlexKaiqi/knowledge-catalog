GITEA_PORT=13000
GITEA_SSH_PORT=12222
ELASTICSEARCH_PORT=19200
KC_PORT=17380
DSH_PORT=17400
DSH_PERMISSION_MODE=workspace-write

# Compose-only fixture credentials. Gitea PATs are generated at runtime into
# the private kc-secrets volume and are never written here.
GITEA_DB_PASSWORD=gitea-compose-db
GITEA_ADMIN_USER=kc-admin
GITEA_ADMIN_PASSWORD=kc-compose-admin
GITEA_AGENT_USER=dsh-agent
GITEA_AGENT_PASSWORD=dsh-compose-agent

# Optional: required only for a real model conversation in DSH.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
