FROM golang:1.25-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/kc ./cmd/kc

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/kc /usr/local/bin/kc
COPY .scenes/data-warehouse/validation/runtime/dsh-stack/scripts/kc-entrypoint.sh /usr/local/bin/kc-entrypoint
RUN chmod 0755 /usr/local/bin/kc-entrypoint

EXPOSE 7380
ENTRYPOINT ["/usr/local/bin/kc-entrypoint"]
